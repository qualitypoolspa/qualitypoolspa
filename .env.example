# TEMPLATE: placeholders only. Do not put real keys in this file; it is the
# one env file that gets committed to git.
#
# Copy it to .env.local (which is gitignored) and fill in the two values from
# the Supabase project (Project Settings -> API). Restart the dev server after.
#
#   cp .env.example .env.local
#
# The anon key is designed to be public: it ships to every visitor's browser
# and is limited by the row-level security policies in
# supabase/migrations/0001_products.sql.
#
# NEVER put the service_role key in this project. It bypasses all security
# rules, and anything prefixed NEXT_PUBLIC_ is shipped to every visitor.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional overrides for the business details in src/config/site.ts.
# NEXT_PUBLIC_SITE_URL=https://qualitypoolspa.es
# NEXT_PUBLIC_CONTACT_EMAIL=info@qualitypoolspa.es
# NEXT_PUBLIC_WHATSAPP=34951173806
# NEXT_PUBLIC_PHONE=+34 951 17 38 06
